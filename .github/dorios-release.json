{
  "$schema": "https://raw.githubusercontent.com/DoriosStudios/Dorios-Workflows/v1.0.2/releases/schemas/project.schema.json",
  "schemaVersion": 1,
  "project": {
    "name": "Paxels & AIOTs",
    "slug": "paxels"
  },
  "release": {
    "changelogPath": "CHANGELOG.md",
    "defaultChannel": "stable",
    "bedrockManifestPaths": [
      "BP/manifest.json",
      "RP/manifest.json"
    ]
  },
  "build": {
    "enabled": true,
    "type": "regolith",
    "developmentProfile": "buildDev",
    "releaseProfile": "buildMinify",
    "outputDirectory": "build",
    "packDirectories": [
      "Paxels & AIOTs BP",
      "Paxels & AIOTs RP"
    ]
  },
  "distribution": {
    "github": true,
    "curseforge": {
      "enabled": true,
      "projectId": 1379131,
      "gameVersion": "26.30"
    }
  },
  "links": {
    "website": "https://doriosstudios.com/projects/paxels/",
    "curseforge": "https://www.curseforge.com/minecraft-bedrock/addons/paxels-aiots",
    "mcpedl": "https://mcpedl.com/paxels-aiots/"
  },
  "announcement": {
    "enabled": true,
    "color": "505030",
    "imageUrl": "https://doriosstudios.com/img/addons/paxels/MCPEDL.png",
    "automaticDelayMinutes": 60
  }
}
